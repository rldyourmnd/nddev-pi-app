{
  "contract_version": 2,
  "product_name": "nddev-pi-app",
  "display_name": "NDDev Pi Setup Manager",
  "description": "Portable, explicit-target setup manager for Pi Coding Agent configuration with a default-on native nddev-builder skill projection.",
  "github_repository": "NDDev-it-com/nddev-pi-app",
  "license": "AGPL-3.0-or-later",
  "manifest_ref": "build/manifest.json",
  "version_ref": "build/version.json",
  "source_root": "setups",
  "managed_state": {
    "managed_files": [
      "agent/settings.json",
      "agent/AGENTS.md",
      "agent/skills/nddev-builder/SKILL.md",
      "agent/packages/nddev-builder/package.json",
      "agent/packages/nddev-builder/skills/nddev-builder/SKILL.md"
    ],
    "managed_file_mode": "0600",
    "preserve_other_state": true,
    "preserve_unmanaged_config_keys": true,
    "preserve_unmanaged_skill_and_package_entries": true,
    "stamp_file": "NDDEV-PI-SETUP.json",
    "stamp_schema": 1
  },
  "setup_system": {
    "catalog_root": "setups",
    "identity_source": "<setup>/setup.json:id",
    "list_command": "python3 cli-tools/nddev_pi.py list [--json]",
    "selection_option": "--setup <id>",
    "setup_ids": [
      "nddev-builder"
    ],
    "default_setup_id": "nddev-builder",
    "profiles_root": "profiles",
    "profile_selection_option": "--profile <id>",
    "profile_ids": [
      "full-auto",
      "safe"
    ],
    "default_profile_id": "full-auto",
    "status_command": "python3 cli-tools/nddev_pi.py status --target <absolute-dir> [--json]"
  },
  "runtime_compatibility": {
    "baseline_ref": "references/pi-baseline.json",
    "version_ref": "build/version.json",
    "supported_hosts": [
      "macos-arm64",
      "macos-x64",
      "ubuntu-glibc-arm64",
      "ubuntu-glibc-x64"
    ],
    "ubuntu_version_floor": null
  },
  "runtime_launch": {
    "command": "pi",
    "direct_command": "<absolute-target>/bin/pi [managed args...]",
    "environment_overrides": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME",
      "TMPDIR",
      "PATH",
      "PI_CODING_AGENT_DIR",
      "PI_CODING_AGENT_SESSION_DIR",
      "PI_PACKAGE_DIR",
      "PI_OFFLINE",
      "PI_SKIP_VERSION_CHECK",
      "PI_TELEMETRY"
    ],
    "forwards_arguments": true,
    "forwards_child_exit_code": true,
    "json_manager_errors_supported": true,
    "manager_command": "python3 cli-tools/nddev_pi.py launch --target <absolute-target> [--workspace <absolute-project-workspace>] -- [args...]",
    "target_role": "configuration-runtime-home",
    "workspace_option": "--workspace <absolute-existing-dir>",
    "default_workspace_source": "caller-cwd-captured-once",
    "explicit_workspace_requirements": [
      "absolute",
      "existing-directory",
      "final-component-not-symlink",
      "accessible"
    ],
    "child_cwd": "resolved-workspace",
    "native_workspace_argument_supported": false,
    "native_workspace_argument": null,
    "native_workspace_source": "@earendil-works/pi-coding-agent@0.84.1 dist/cli/args.js and official CLI reference do not expose a workspace/project/cwd option",
    "blocked_forwarded_scope_overrides": [
      "--workspace",
      "--project",
      "--project-dir",
      "--project-directory",
      "--cwd",
      "--workdir",
      "--working-directory",
      "--directory",
      "--dir",
      "-C"
    ],
    "provider_secret_inheritance": "child-process-allowlist-only",
    "requires_clean_managed_target": true,
    "streams_child_stdio": true,
    "successful_child_output_wrapped": false,
    "target_environment_scope": "child-process-only"
  },
  "software": {
    "package": "@earendil-works/pi-coding-agent",
    "current_version": "0.84.1",
    "command": "pi",
    "bin": "dist/cli.js",
    "node_requirement": ">=22.19.0",
    "registry_integrity": "sha512-ncAqFrG+iybuPGOhMiZoEHkEzTpJgz3guYD32pD+M7ucc0WeHmauP6wa7qwP8V/KWvsZDVNa5XGsdZ7fkC7w7A==",
    "registry_shasum": "e098cada629fdeeb9df6e77c6d480d43e1b2c553",
    "repository": "https://github.com/earendil-works/pi",
    "plan_command": "python3 cli-tools/nddev_pi.py software-plan --target <absolute-dir> [--json]",
    "status_command": "python3 cli-tools/nddev_pi.py software-status --target <absolute-dir> [--json]",
    "install_command": "python3 cli-tools/nddev_pi.py software-install --target <absolute-dir> [--json]",
    "update_command": "python3 cli-tools/nddev_pi.py software-update --target <absolute-dir> [--json]",
    "install_execution": "npm view + npm pack in isolated staging, pinned SRI/sha1 tarball verification, local extraction with scripts disabled, then atomic swap",
    "update_execution": "safe partial repair/update through isolated staging and rollback",
    "installer": {
      "tool": "npm",
      "metadata_argv": [
        "view",
        "@earendil-works/pi-coding-agent@0.84.1",
        "dist",
        "--json"
      ],
      "pack_argv": [
        "pack",
        "--json",
        "--ignore-scripts",
        "--pack-destination",
        "<stage>/tarballs",
        "@earendil-works/pi-coding-agent@0.84.1"
      ],
      "argv": [
        "install",
        "--global-style",
        "--ignore-scripts",
        "--no-audit",
        "--no-fund",
        "--package-lock=false",
        "--prefix",
        "<stage>/install",
        "<verified-tarball>"
      ],
      "trust": false,
      "byte_verification": {
        "metadata_integrity": "sha512-ncAqFrG+iybuPGOhMiZoEHkEzTpJgz3guYD32pD+M7ucc0WeHmauP6wa7qwP8V/KWvsZDVNa5XGsdZ7fkC7w7A==",
        "metadata_shasum": "e098cada629fdeeb9df6e77c6d480d43e1b2c553",
        "tarball_integrity": "sha512-ncAqFrG+iybuPGOhMiZoEHkEzTpJgz3guYD32pD+M7ucc0WeHmauP6wa7qwP8V/KWvsZDVNa5XGsdZ7fkC7w7A==",
        "tarball_shasum": "e098cada629fdeeb9df6e77c6d480d43e1b2c553",
        "verified_before_extract": true
      },
      "env": {
        "HOME": "<stage>/home",
        "npm_config_cache": "<stage>/cache",
        "npm_config_ignore_scripts": "true",
        "npm_config_userconfig": "<stage>/npmrc",
        "XDG_CONFIG_HOME": "<stage>/xdg-config",
        "TMPDIR": "<stage>/tmp"
      },
      "local_install_argv": [
        "install",
        "--global-style",
        "--ignore-scripts",
        "--no-audit",
        "--no-fund",
        "--package-lock=false",
        "--prefix",
        "<stage>/install",
        "<verified-tarball>"
      ]
    },
    "staged_tree_policy": {
      "max_paths_per_tree": 25000,
      "max_logical_bytes_per_tree": 201326592,
      "preserved_checks": [
        "bounded-regular-file-reads",
        "bounded-tree-path-count",
        "bounded-tree-logical-bytes",
        "no-staged-symlink-escape",
        "no-persisted-symlinks",
        "no-hardlinks",
        "private-path-modes",
        "package-layout",
        "entrypoint-sha256",
        "package-binary-sha256",
        "installed-tree-sha256"
      ],
      "recorded_runtime_metrics": [
        "installed_tree_path_count",
        "installed_tree_bytes",
        "tree_limits"
      ]
    },
    "entrypoint_materialization": {
    "npm_source": "<stage>/install/node_modules/.bin/pi",
      "required_package_target": "<stage>/install/node_modules/@earendil-works/pi-coding-agent/dist/cli.js",
      "persisted_kind": "private-relative-node-wrapper",
      "persisted_path": ".nddev-pi-software/current/bin/pi",
      "persisted_mode": "0700",
      "persisted_symlink": false
    },
    "version_identity": {
      "required_package_version": "0.84.1",
    "package_version_source": ".nddev-pi-software/current/install/node_modules/@earendil-works/pi-coding-agent/package.json",
      "probe_argv": [
        "bin/pi",
        "--version"
      ],
      "expected_probe_output": "0.0.0",
      "package_and_probe_must_both_match": true
    },
    "target_owned": {
      "software_root": ".nddev-pi-software/current",
      "entrypoint": "bin/pi",
      "stamp_file": "NDDEV-PI-SOFTWARE.json",
      "status_executes_target_binary": false,
      "launch_uses_target_entrypoint": true
    },
    "registry_tarball": "https://registry.npmjs.org/@earendil-works/pi-coding-agent/-/pi-coding-agent-0.84.1.tgz"
  },
  "builder_projection": {
    "default_on": true,
    "installation": {
      "install_command": "python3 cli-tools/nddev_pi.py install --setup nddev-builder --profile <id> --target <absolute-target> [--json]",
      "native_settings_keys": [
        "skills",
        "packages",
        "enableSkillCommands"
      ],
      "native_package_path": "builder/nddev-builder/package.json",
      "preserved_on_switch_restore": true,
      "status_command": "python3 cli-tools/nddev_pi.py status --target <absolute-target> [--json]"
    },
    "official_documentation": {
      "settings": "https://pi.dev/docs/latest/settings",
      "packages": "https://pi.dev/docs/latest/packages",
      "environment_variables": "https://pi.dev/docs/latest/environment-variables"
    },
    "marketplace": {
      "catalog_url": "https://pi.dev/packages",
      "module_installs_catalog_package": false,
      "external_marketplace_published": null,
      "status": "unsupported-by-this-manager"
    },
    "surfaces": [
      "settings.skills",
      "settings.packages",
      "package.pi.skills",
      "agent.AGENTS.md"
    ],
    "unsupported_surfaces": {
      "mcp": "available through third-party Pi extensions/packages, not projected by this manager",
      "plugin_marketplace": null
    }
  },
  "provider_protocol": {
    "version": 3,
    "bundle_format": "ai-stp-bundle/1",
    "commands": ["provider-info", "validate-bundle", "plan-operation", "apply-operation", "recover-operation", "status"],
    "operations": ["backup", "install", "remove", "replace", "restore"],
    "permission_profiles": ["safe", "full-auto"],
    "component_kinds": ["instruction", "plugin", "setting", "skill"],
    "unsupported_component_kinds": ["agent", "command", "hook", "mcp"],
    "native_namespaces": ["agent/AGENTS.md", "agent/packages", "agent/settings.json", "agent/skills"],
    "state_file": "NDDEV-PI-PROVIDER.json",
    "exact_provenance": ["setup_passport_digest", "component_refs", "bundle_digest", "artifact_digest", "provider_release_digest", "plan_digest", "target_identity_digest", "native_ownership"],
    "optional_standalone_lifecycle": ["software-plan", "software-status", "software-install", "software-update", "launch"]
  },
  "safety": {
    "absolute_target_required": true,
    "canonical_target_binding": true,
    "default_target": null,
    "explicit_target_required": [
      "status",
      "plan",
      "install",
      "switch",
      "restore",
      "remove",
      "launch"
    ],
    "max_backups": 10,
    "backup_envelope_schema": 2,
    "backup_records_sizes_and_digests": true,
    "backup_exact_managed_path_set": true,
    "backup_full_pool_behavior": "fail-closed",
    "missing_target_argument_rejected": true,
    "new_target_mode": "0700",
    "preserve_existing_target_mode": true,
    "relative_target_rejected": true,
    "rollback_on_failure": true,
    "target_symlinks_rejected": true,
    "external_lifecycle_coordination": {
      "product_anchor": "global.lock",
      "canonical_target_anchor": "<sha256>.target.lock",
      "read_only_creates_anchors": false,
      "cold_no_anchor_namespace": "bounded-empty-or-fail-closed-retry-whole-read",
      "mutation_publishes_missing_target_anchor": true,
      "publication": "atomic no-replace hardlink of complete fsynced binding",
      "published_anchors_unlinked_by_lifecycle": false
    },
    "cleanup_journal": {
      "cleanup_parent": ".nddev-pi-cleanup",
      "prepare_intent": "durable before first source-to-tombstone move",
      "pending_flag": "cleanup_pending",
      "read_only_repairs": false,
      "mutation_drains_before_active_change": true,
      "absolute_paths_in_documents": false
    },
    "switch_noop": {
      "same_setup_profile_result": "success",
      "changed": [],
      "backup_slot": null,
      "managed_transaction": false,
      "backup_created": false,
      "cleanup_pending_drains_before_result": true
    },
    "setup_rollback": {
      "strategy": "object-preserving held managed files",
      "restores_original_file_identity": true,
      "backup_commit_after_desired_postcondition": true
    },
    "software_rollback": {
      "strategy": "object-preserving cleanup intent replacements",
      "restores_original_file_identity": true,
      "prepare_intent_before_visible_replacement": true,
      "committed_success_cleanup_pending": true
    }
  }
}
