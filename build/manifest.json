{
  "schema_version": 2,
  "name": "nddev-pi-app",
  "build_version": "0.2.0",
  "entrypoint": "python3 cli-tools/nddev_pi.py",
  "source_root": "setups",
  "setup_ids": [
    "nddev-builder"
  ],
  "profile_ids": [
    "full-auto",
    "safe"
  ],
  "default_setup_id": "nddev-builder",
  "default_profile_id": "full-auto",
  "managed_files": [
    "agent/settings.json",
    "agent/AGENTS.md",
    "agent/skills/nddev-builder/SKILL.md",
    "agent/packages/nddev-builder/package.json",
    "agent/packages/nddev-builder/skills/nddev-builder/SKILL.md",
    "NDDEV-PI-SETUP.json"
  ],
  "command_policy": {
    "json_supported": [
      "list",
      "status",
      "plan",
      "install",
      "switch",
      "restore",
      "remove",
      "software-plan",
      "software-status",
      "software-install",
      "software-update"
    ],
    "plan_mutates": false,
    "restore_backup_option": "--backup <0..9>",
    "target_required": [
      "status",
      "plan",
      "install",
      "switch",
      "restore",
      "remove",
      "launch"
    ]
  },
  "backup_policy": {
    "canonical_target_bound": true,
    "envelope": "NDDEV-PI-BACKUP.json",
    "envelope_schema": 2,
    "file_metadata": [
      "size",
      "sha256"
    ],
    "exact_managed_path_set": true,
    "location": "sibling .<target-name>.nddev-pi-backups",
    "slots": 10,
    "full_pool_behavior": "fail-closed"
  },
  "runtime_compatibility": {
    "baseline_ref": "references/pi-baseline.json",
    "version_ref": "build/version.json",
    "supported_hosts": [
      "macos-arm64",
      "macos-x64",
      "ubuntu-glibc-arm64",
      "ubuntu-glibc-x64"
    ]
  },
  "runtime_launch": {
    "command": "pi",
    "direct_command": "<absolute-target>/bin/pi [managed args...]",
    "environment_overrides": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME",
      "TMPDIR",
      "PATH",
      "PI_CODING_AGENT_DIR",
      "PI_CODING_AGENT_SESSION_DIR",
      "PI_PACKAGE_DIR",
      "PI_OFFLINE",
      "PI_SKIP_VERSION_CHECK",
      "PI_TELEMETRY"
    ],
    "forwards_arguments": true,
    "forwards_child_exit_code": true,
    "json_manager_errors_supported": true,
    "manager_command": "python3 cli-tools/nddev_pi.py launch --target <absolute-target> [--workspace <absolute-project-workspace>] -- [args...]",
    "target_role": "configuration-runtime-home",
    "workspace_option": "--workspace <absolute-existing-dir>",
    "default_workspace_source": "caller-cwd-captured-once",
    "explicit_workspace_requirements": [
      "absolute",
      "existing-directory",
      "final-component-not-symlink",
      "accessible"
    ],
    "child_cwd": "resolved-workspace",
    "native_workspace_argument_supported": false,
    "native_workspace_argument": null,
    "native_workspace_source": "@earendil-works/pi-coding-agent@0.84.1 dist/cli/args.js and official CLI reference do not expose a workspace/project/cwd option",
    "blocked_forwarded_scope_overrides": [
      "--workspace",
      "--project",
      "--project-dir",
      "--project-directory",
      "--cwd",
      "--workdir",
      "--working-directory",
      "--directory",
      "--dir",
      "-C"
    ],
    "provider_secret_inheritance": "child-process-allowlist-only",
    "requires_clean_managed_target": true,
    "streams_child_stdio": true,
    "successful_child_output_wrapped": false,
    "target_environment_scope": "child-process-only"
  },
  "software": {
    "package": "@earendil-works/pi-coding-agent",
    "version": "0.84.1",
    "command": "pi",
    "bin": "dist/cli.js",
    "node_requirement": ">=22.19.0",
    "registry_integrity": "sha512-ncAqFrG+iybuPGOhMiZoEHkEzTpJgz3guYD32pD+M7ucc0WeHmauP6wa7qwP8V/KWvsZDVNa5XGsdZ7fkC7w7A==",
    "registry_shasum": "e098cada629fdeeb9df6e77c6d480d43e1b2c553",
    "installer": {
      "tool": "npm",
      "metadata_argv": [
        "view",
        "@earendil-works/pi-coding-agent@0.84.1",
        "dist",
        "--json"
      ],
      "pack_argv": [
        "pack",
        "--json",
        "--ignore-scripts",
        "--pack-destination",
        "<stage>/tarballs",
        "@earendil-works/pi-coding-agent@0.84.1"
      ],
      "argv": [
        "install",
        "--global-style",
        "--ignore-scripts",
        "--no-audit",
        "--no-fund",
        "--package-lock=false",
        "--prefix",
        "<stage>/install",
        "<verified-tarball>"
      ],
      "trust": false,
      "byte_verification": {
        "metadata_integrity": "sha512-ncAqFrG+iybuPGOhMiZoEHkEzTpJgz3guYD32pD+M7ucc0WeHmauP6wa7qwP8V/KWvsZDVNa5XGsdZ7fkC7w7A==",
        "metadata_shasum": "e098cada629fdeeb9df6e77c6d480d43e1b2c553",
        "tarball_integrity": "sha512-ncAqFrG+iybuPGOhMiZoEHkEzTpJgz3guYD32pD+M7ucc0WeHmauP6wa7qwP8V/KWvsZDVNa5XGsdZ7fkC7w7A==",
        "tarball_shasum": "e098cada629fdeeb9df6e77c6d480d43e1b2c553",
        "verified_before_extract": true
      },
      "consumer_lifecycle_scripts": false,
      "local_install_argv": [
        "install",
        "--global-style",
        "--ignore-scripts",
        "--no-audit",
        "--no-fund",
        "--package-lock=false",
        "--prefix",
        "<stage>/install",
        "<verified-tarball>"
      ]
    },
    "target_owned": {
      "software_root": ".nddev-pi-software/current",
      "entrypoint": "bin/pi",
      "stamp_file": "NDDEV-PI-SOFTWARE.json",
      "status_executes_target_binary": false,
      "launch_uses_target_entrypoint": true
    },
    "install_execution": "npm view + npm pack with pinned tarball verification",
    "registry_tarball": "https://registry.npmjs.org/@earendil-works/pi-coding-agent/-/pi-coding-agent-0.84.1.tgz"
  },
  "builder_projection": {
    "status": "native-settings-skill-and-local-package-projection",
    "default_on": true,
    "target_skill_path": "agent/skills/nddev-builder",
    "target_package_path": "agent/packages/nddev-builder",
    "surfaces": [
      "settings.skills",
      "settings.packages",
      "package.pi.skills",
      "agent.AGENTS.md"
    ],
    "official_documentation": {
      "settings": "https://pi.dev/docs/latest/settings",
      "packages": "https://pi.dev/docs/latest/packages",
      "environment_variables": "https://pi.dev/docs/latest/environment-variables"
    },
    "marketplace": {
      "catalog_url": "https://pi.dev/packages",
      "module_installs_catalog_package": false,
      "external_marketplace_published": null,
      "status": "unsupported-by-this-manager"
    }
  },
  "transaction_policy": {
    "managed_file_mode": "0600",
    "new_target_mode": "0700",
    "preserve_existing_target_mode": true,
    "preserve_unmanaged_files": true,
    "preserve_unmanaged_config_keys": true,
    "preserve_unmanaged_skill_and_package_entries": true,
    "reject_symlink_managed_files": true,
    "rollback_on_failure": true,
    "staging": "same-parent temporary directory",
    "lock": "monotonic product and canonical target anchors",
    "read_only_lock_creation": false,
    "cold_no_anchor_namespace": "bounded-empty-or-fail-closed-retry-whole-read",
    "anchor_publication": "complete fsynced temp plus atomic no-replace hardlink",
    "external_coordination_root": "private sticky-temp namespace declared by cli-tools/nddev_pi.py",
    "cleanup_journal": {
      "pending_flag": "cleanup_pending",
      "prepare_intent": "durable before first source-to-tombstone move",
      "journal": "complete immutable no-replace pending.json",
      "read_only_repairs": false,
      "mutation_drains_before_active_change": true
    },
    "switch_noop": {
      "same_setup_profile_result": "success",
      "changed": [],
      "backup_slot": null,
      "managed_transaction": false,
      "backup_created": false,
      "cleanup_pending_drains_before_result": true
    },
    "setup_rollback": {
      "strategy": "object-preserving held managed files",
      "restores_original_file_identity": true,
      "backup_commit_after_desired_postcondition": true
    },
    "software_rollback": {
      "strategy": "object-preserving cleanup intent replacements",
      "restores_original_file_identity": true,
      "prepare_intent_before_visible_replacement": true,
      "committed_success_cleanup_pending": true
    }
  },
  "provider_protocol": {
    "version": 3,
    "bundle_format": "ai-stp-bundle/1",
    "commands": ["provider-info", "validate-bundle", "plan-operation", "apply-operation", "status"],
    "operations": ["backup", "install", "remove", "replace", "restore"],
    "permission_profiles": ["safe", "full-auto"],
    "component_kinds": ["instruction", "plugin", "setting", "skill"],
    "unsupported_component_kinds": ["agent", "command", "hook", "mcp"],
    "native_namespaces": ["agent/AGENTS.md", "agent/packages", "agent/settings.json", "agent/skills"],
    "state_file": "NDDEV-PI-PROVIDER.json"
  },
  "profiles": {
    "default": "full-auto",
    "available": [
      "full-auto",
      "safe"
    ],
    "full-auto": {
      "project_trust": "always",
      "managed_launch_args": [
        "--offline",
        "--approve"
      ],
      "tool_boundary": "normal-pi-tools",
      "os_security_boundary": false
    },
    "safe": {
      "project_trust": "never",
      "managed_launch_args": [
        "--offline",
        "--no-session",
        "--no-approve",
        "--tools",
        "read,grep,find,ls"
      ],
      "tool_boundary": "pi-read-only-builtins",
      "os_security_boundary": false,
      "status": "future-switch-profile"
    }
  }
}
